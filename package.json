{
  "name": "d2s-studio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/asset-manifest.mjs",
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "prebuild:next": "node scripts/asset-manifest.mjs",
    "build:next": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "assets:agents": "node scripts/build-agents.mjs",
    "assets:manifest": "node scripts/asset-manifest.mjs",
    "test:visual": "playwright test",
    "shots": "node scripts/shots.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "assets:plants": "node scripts/fetch-polyhaven.mjs && node scripts/build-plants.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "maath": "0.10.8",
    "next": "16.3.5",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "meshoptimizer": "^1.1.1",
    "sharp": "0.35.4",
    "typescript": "^5",
    "wrangler": "4.136.1"
  }
}
