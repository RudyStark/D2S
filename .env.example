# Copy to .env.local (never commit real values).

# Where contact requests are delivered: a webhook URL (Make, Zapier, n8n, CRM…), server-side only.
# Without it the form works in development (requests are logged) and is refused in production.
CONTACT_WEBHOOK_URL=

# Production domain (no trailing slash): canonical URLs, share previews, sitemap, robots, structured data.
NEXT_PUBLIC_SITE_URL=
