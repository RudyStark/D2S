# Copy to .env.local (never commit real values).

# May — the reception agent (Claude API). Server-side only: a Worker SECRET in production.
ANTHROPIC_API_KEY=
# Only for an organization-level key (not scoped to a workspace): the workspace ID to bill.
ANTHROPIC_WORKSPACE_ID=
# Optional: model (default claude-sonnet-5) and effort (low by default, medium or high).
MAY_MODEL=
MAY_EFFORT=

# May — Calendly Personal Access Token and public booking fallback.
# CALENDLY_USER_URI is optional: /users/me is used when it is empty.
CALENDLY_API_TOKEN=
CALENDLY_USER_URI=
CALENDLY_FALLBACK_URL=
# Optional: the appointment type offered in the contact form (default: the first active one).
CALENDLY_EVENT_TYPE_ID=

# Contact — Resend. Verify d2saigency.com in Resend before using may@d2saigency.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL="May — D2S AIgency <may@d2saigency.com>"
RESEND_REPLY_TO_EMAIL=may@d2saigency.com
# Requests and bookings go to the team; May (RESEND_FROM_EMAIL) only signs the visitor's emails.
CONTACT_TO_EMAIL=rudy.saksik@d2saigency.com

# Optional secondary delivery to Make, Zapier, n8n or a CRM.
CONTACT_WEBHOOK_URL=

# Production domain (no trailing slash): canonical URLs, share previews, sitemap, robots, structured data.
NEXT_PUBLIC_SITE_URL=
